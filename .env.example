# Copy to .env and fill in. Everything is optional in development.

PORT=5000
NODE_ENV=development

# Comma separated list of frontend origins, leave empty to allow all
CORS_ORIGIN=

# Required in production. Without it a random secret is used per restart.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# e.g. mongodb+srv://user:pass@cluster.mongodb.net/vehicle_tracker
# Without it an in-memory MongoDB is used and data is lost on restart.
MONGO_URI=

# e.g. redis://localhost:6379 - without it live trip state is kept in memory
REDIS_URL=

# Needed for real road routes, ETA and traffic alerts
MAPBOX_ACCESS_TOKEN=

# Path to the Firebase service account JSON file (or the JSON itself)
FIREBASE_SERVICE_ACCOUNT=

# Detection thresholds (defaults shown)
ARRIVAL_RADIUS_M=100
DEVIATION_THRESHOLD_M=200
DEVIATION_CONFIRM_PINGS=2
STATIONARY_RADIUS_M=30
STATIONARY_MINUTES=5
SIGNAL_LOST_MINUTES=3
TRAFFIC_CHECK_SECONDS=120
TRAFFIC_DELAY_MINUTES=5
TRAFFIC_DELAY_RATIO=1.25
TRAFFIC_ALERT_COOLDOWN_MINUTES=15
MAX_ACCURACY_M=100
# A driver cannot start a trip below this battery level unless the phone is charging
MIN_START_BATTERY=30
